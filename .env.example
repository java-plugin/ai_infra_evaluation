# OpenAI-compatible LLM provider (defaults to DeepSeek)
# Leave blank to run Agent in offline / rule-based mode
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Where to find data / docs / reports (defaults to repo layout)
AI_INFRA_DATA_DIR=./data
AI_INFRA_REPORT_DIR=./reports
